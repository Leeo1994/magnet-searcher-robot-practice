//______________________[checkTurn]_______________________

//check difference between current rotation and target

bool checkTurn() {
  // Convert radians to degrees
  float current_angle = pose.theta * (180 / PI); //12.99(rad) --> 747.03(degs)
  Serial.println(current_angle);

  // Calculate the difference between the target angle and the current angle
  float angle_diff = target_angle - current_angle; //45(degs) - 747.03(degs) = -702.03
  Serial.println(angle_diff);

  // Normalize angle_diff to the range (-180, 180)
  angle_diff = fmod(angle_diff + 180, 360) - 180;
  Serial.println("normalized angle diff");
  Serial.print(angle_diff);

  isTurning = true;
  // The robot should start turning to reach the threshold <------------------------- start turning
  if (abs(angle_diff) >= TURN_THRESHOLD) {
    if (angle_diff > 0) {
      // Turn right (L:R --> positive:negative)
      motors.setPWM(25, -25);
    } else {
      // Turn left (L:R --> negative:positive)
      motors.setPWM(-25, 25);
    }
    // Still turning
    return false;
  }

  // If the difference is small enough, consider the turn complete
  // Stop the motors
  motors.setPWM(0, 0);
  return true; // Turn complete



  //______________________[shortTurn]_______________________


  //Trigger the shortest turn both ways -- RADIANS!
  //call first then checkturn to see if it should stop

  void randTurn(float target_angle) {
    isTurning = true; //turning

    target_angle = target_angle * (PI / 180.0); //change to radians

    checkTurn();

    if (checkTurn == false) {

      float turn_R = (target_angle - (-1 * pose.theta)); //turning right - lower turn value
      float turn_L = (target_angle - pose.theta); //turning left - higher turn value

      if (abs(turn_R) <= abs(turn_L)) {

        //turn right
        motors.setPWM(25, -25); //(L:R) Turn Left
      }
      else

        //turn left
        motors.setPWM(-25, 25); //(L:R) Turn Left
    }
    isTurning = false; //turning complete

  }// End of randTurn




