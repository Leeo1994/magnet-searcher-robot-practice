float normalizeAngle(float angle) {
  while (angle > 180) angle -= 360;
  while (angle < -180) angle += 360;
  return angle;
}


//_____________________[rotatetoorigin]_____________________

void rotateToOrigin() {
  // Get the robot's current position and orientation
  float x = pose.x;
  float y = pose.y;
  float theta_I = pose.theta;

  // Calculate the angle towards the origin (theta_H)
  float theta_H = atan2(y, x) * (180.0 / PI); // Convert radians to degrees

  // Calculate the angle to rotate
  float angleToOrigin = theta_H - theta_I;

  // Normalize the angle
  angleToOrigin = normalizeAngle(angleToOrigin);

  // Speed can be proportional to angle
  float speed = 20; // Base speed
  if (fabs(angleToOrigin) > 1.0) { // Allow a small tolerance
    // Adjust speed based on angle to make it smoother
    speed *= (fabs(angleToOrigin) / 180.0); // Scale speed

    // Determine motor speeds based on the angle to turn
    if (angleToOrigin > 0) { // Turn right
      motors.setPWM(speed, -speed); // Right wheel forward, left wheel backward
    } else { // Turn left
      motors.setPWM(-speed, speed); // Left wheel backward, right wheel forward
    }
  } else {
    // Stop the motors if facing the origin
    motors.setPWM(0, 0); // Stop both motors
  }
}



