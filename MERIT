//______________________[blinkLeds]_______________________

void blinkLeds() {

  if (millis() - last_led >= 100) {  // 100ms interval

    last_led = millis();

    ledState = !ledState;              // Toggle LED state

    digitalWrite(LED_BUILTIN, ledState);   // Write new LED state
  }
}

//______________________[updatePose]_______________________

//updates pose at a 20ms interval
void updatePose() {

  if (current_millis - last_millis >= 20) {

    // Instruct the kinematics to perform an update of the robot position recommended at a fixed interval 20ms.
    pose.update();

    last_millis = current_millis;
  }
}

//______________________[setTurn]_______________________

void setTurn(float target_angle) {

  // Convert target angle to radians
  float target_angle_rad = -target_angle * (PI / 180.0);

  // Calculate the angular difference and normalize it
  float angle_diff = pose.theta - target_angle_rad;

  // Normalize the angular difference to [-PI, PI]
  angle_diff = atan2(sin(angle_diff), cos(angle_diff));  // This normalizes the angle

  Serial.println("theta:");
  Serial.println(pose.theta);
  Serial.println("angle_diff:");
  Serial.println(angle_diff);

  if (abs(angle_diff) > TURN_THRESHOLD) {
    // Continue spinning until the target angle is reached

    if (angle_diff > 0) {
      // Turn right --> negative theta
      motors.setPWM(20, -20);

    } else if (angle_diff < 0) {
      // Turn left --> positive theta
      motors.setPWM(-20, 20);
    }

    //Serial.println("Spinning to reach target angle");
    facingOrigin = false;

  } else {
    // Stop spinning when the target angle is reached
    motors.setPWM(0, 0);  // Stop motors
    //Serial.println("Reached target angle");
    Serial.println("theta");
    Serial.println(pose.theta);
    facingOrigin = true;
  }
}
